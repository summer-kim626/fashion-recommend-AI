# Firebase 프로젝트(fashion-ai-chat)에 배포될 "비밀이 아닌" 설정 (깃허브에 올라가도 되는 값만)
# API 키·관리자 비밀번호는 여기 넣지 말고 Secret Manager에 등록하세요:
#   firebase functions:secrets:set ANTHROPIC_API_KEY
#   firebase functions:secrets:set ADMIN_PASSWORD
CLAUDE_MODEL=claude-sonnet-5-5
MAX_TOKENS=1024
ANTHROPIC_VERSION=2026-10-21
# 공개 사이트에서는 로그인 화면에 비밀번호를 보여주지 않음 (보여주려면 true)
SHOW_ADMIN_PASSWORD=false
# 1분당 요청 제한 (서버 인스턴스별)
RATE_CHAT_PER_MIN=20
RATE_LOGIN_PER_MIN=10
RATE_DRAFT_PER_MIN=10

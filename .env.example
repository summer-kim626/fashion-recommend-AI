# ─────────────────────────────────────────────
# 이 파일을 복사해서 이름을 ".env" 로 바꾼 뒤 값을 채우세요.
# .env 는 비밀 정보가 들어가므로 깃허브 등에 올리지 마세요. (.gitignore에 포함됨)
# ─────────────────────────────────────────────

# [필수] Claude API 키 (https://platform.claude.com 에서 발급)
ANTHROPIC_API_KEY=

# 사용할 모델 (기본값: claude-sonnet-5-5 / 더 저렴·빠른 모델: claude-haiku-5-5)
CLAUDE_MODEL=claude-sonnet-5-5

# 답변 최대 길이(토큰)
MAX_TOKENS=1024

# 관리자 비밀번호 (로그인 화면에 표시됨)
ADMIN_PASSWORD=1234
# 로그인 화면에 비밀번호를 보여줄지 (true / false)
SHOW_ADMIN_PASSWORD=true

# 서버 포트 (http://localhost:3000)
PORT=3000

# Claude API 버전 헤더 (보통 바꾸지 않음)
ANTHROPIC_VERSION=2026-10-21
